#!/bin/bash

JOBS=10000
RUNNER="delayed_job"
CONCURRENCY_STEPS=(1 2 4 8)
RUNS=30

for ((i=0;i<$RUNS;i++)); do
  bin/rails runner "Delayed::Job.delete_all"
  ./bin/perform_benchmark "cpu" $JOBS $RUNNER "single" "${CONCURRENCY_STEPS[@]}";
done
bin/calculate_medians $RUNNER "single" "cpu"

CONCURRENCY_STEPS=(1)

for ((i=0;i<$RUNS;i++)); do
  bin/rails runner "Delayed::Job.delete_all"
 ./bin/perform_benchmark "io" $JOBS $RUNNER "single" "${CONCURRENCY_STEPS[@]}";
done
bin/calculate_medians $RUNNER "single" "io"
