#!/bin/bash

DURATION_SECONDS=60
RUNNER="queue_classic"
CONCURRENCY_STEPS=(1 2 4 8)
RUNS=29

for ((i=0;i<$RUNS;i++)); do
 ./bin/perform_benchmark "cpu" $DURATION_SECONDS $RUNNER "single" "${CONCURRENCY_STEPS[@]}";
done
bin/calculate_medians $RUNNER "single" "cpu"

CONCURRENCY_STEPS=(1)

for ((i=0;i<$RUNS;i++)); do
 ./bin/perform_benchmark "io" $DURATION_SECONDS $RUNNER "single" "${CONCURRENCY_STEPS[@]}";
done
bin/calculate_medians $RUNNER "single" "io"
