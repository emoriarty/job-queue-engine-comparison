#!/bin/bash

# CLEAR GOODJOB DATA
bundle exec rails runner "GoodJob::Job.delete_all"

JOBS=10000
RUNNER="good_job"
CONCURRENCY_STEPS=(1 2 4 8)

for ((i=0;i<30;i++)); do ./bin/benchmark_cpu $JOBS $RUNNER "sharded_queues" "${CONCURRENCY_STEPS[@]}"; done
bin/calculate_medians_with_gini_coefficient $RUNNER $BENCHMARK_TYPE "cpu"

for ((i=0;i<30;i++)); do ./bin/benchmark_io $JOBS $RUNNER "sharded_queues" "${CONCURRENCY_STEPS[@]}"; done
bin/calculate_medians_with_gini_coefficient $RUNNER $BENCHMARK_TYPE "io"

for ((i=0;i<30;i++)); do ./bin/benchmark_cpu $JOBS $RUNNER "single_queue" "${CONCURRENCY_STEPS[@]}"; done
bin/calculate_medians_with_gini_coefficient $RUNNER $BENCHMARK_TYPE "cpu"

for ((i=0;i<30;i++)); do ./bin/benchmark_io $JOBS $RUNNER "single_queue" "${CONCURRENCY_STEPS[@]}"; done
bin/calculate_medians_with_gini_coefficient $RUNNER $BENCHMARK_TYPE "io"
